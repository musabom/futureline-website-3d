# @react-three/drei@10 peer-requires react@^19, but this project runs
# react@18.3.1 (required by the rest of the R3F stack as installed). npm 7+
# treats that as a hard error, so a plain `npm install` fails outright — the
# existing node_modules was only produced by passing --legacy-peer-deps.
#
# Setting it here means `npm install` just works for everyone instead of
# depending on each person remembering the flag.
#
# Cleaner permanent fix: @react-three/drei and @14islands/r3f-scroll-rig are
# both currently imported nowhere in src/. Dropping them removes the conflict
# entirely. Left in place for now since that is the repo owner's call.
legacy-peer-deps=true

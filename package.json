    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.3",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.5.0",
